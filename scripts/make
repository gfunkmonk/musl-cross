#!/bin/bash

set -e

if [[ $# -lt 1 || -z "$1" ]]; then
    echo "Usage: $0 <target>" >&2
    echo "Example: $0 x86_64-unknown-linux-musl" >&2
    exit 1
fi

TARGET=$1

if [[ ! -d "targets/${TARGET}" ]]; then
    echo "Error: target '${TARGET}' not found in targets/" >&2
    exit 1
fi

# packages
export DEBIAN_FRONTEND=noninteractive
PACKAGES=(
    automake bison build-essential bzip2 ca-certificates cmake curl file
    flex gawk gdb git gperf help2man libncurses-dev libssl-dev libtool-bin
    libzstd-dev pkg-config python3 rsync texinfo unzip wget xz-utils
)

sudo -E apt-get update -qy
sudo -E apt-get install -y --no-install-recommends "${PACKAGES[@]}"

# patch
pushd builder
git reset --hard HEAD
git clean -fd
shopt -s nullglob
for i in ../targets/"${TARGET}"/*.patch; do
    patch -Np1 -i "$i"
done
shopt -u nullglob
popd

# crosstool-ng
sudo mkdir -p /opt
sudo chmod 0777 /opt
sudo rm -rf /opt/ct-ng
pushd builder
./bootstrap
./configure --prefix=/opt/ct-ng
make -j"$(nproc)"
sudo make install
popd

# build
rm -rf build
mkdir -p build
cp targets/"${TARGET}"/config build/.config
# Configure tarballs directory for download caching
echo 'CT_LOCAL_TARBALLS_DIR="/mnt/tarballs"' >> build/.config
echo 'CT_SAVE_TARBALLS=y' >> build/.config
case "${TARGET}" in
    or1k-*|microblaze*|mips*)
        sed -i 's/^CT_LINKER_MOLD=y/# CT_LINKER_MOLD is not set/' build/.config
        echo "Disabled mold for ${TARGET} (unsupported arch)"
        ;;
esac
pushd build
/opt/ct-ng/bin/ct-ng olddefconfig
/opt/ct-ng/bin/ct-ng build
popd

# tarball
sudo mv /opt/x-tools/"${TARGET}" .
sudo chown -R root:root "${TARGET}"
env XZ_OPT="-T0" sudo tar -cJvf "${TARGET}".tar.xz "${TARGET}"
sudo sha256sum "${TARGET}".tar.xz | awk '{ print $1 }' > "${TARGET}".tar.xz.sha256
